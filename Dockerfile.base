# ─── Base image: PHP builder (composer installs) ──────────────────────────────
# PHP 8.3.37 fixes the Nov 2026 PHP release CVEs (CVE-2026-115560,
# CVE-2026-126714, CVE-2026-129481 and others). 8.3.36 fixed PHP2Shell.
# Keep both FROM lines on the same patch release, 8.3.37 or later.
FROM php:8.3.37-alpine AS php-builder

RUN apk add --no-cache sqlite-dev libzip-dev oniguruma-dev mariadb-dev unzip \
    && docker-php-ext-install pdo pdo_sqlite pdo_mysql mbstring bcmath zip

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# ─── Base image: Frontend builder (PHP + Node for Vite/Wayfinder builds) ──────
# Extends php-builder so PHP extensions don't need to be recompiled.
FROM php-builder AS frontend-builder

RUN apk add --no-cache nodejs npm

# ─── Base image: Runtime (PHP-FPM + nginx + supervisor) ───────────────────────
# Copies pre-compiled extensions from php-builder to avoid QEMU compilation.
FROM php:8.3.37-fpm-alpine AS runtime

RUN apk add --no-cache \
        nginx \
        supervisor \
        sqlite \
        libzip \
        oniguruma \
        mariadb-connector-c \
        curl

# Reuse extensions compiled in php-builder (same PHP 8.3 ABI)
COPY --from=php-builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
RUN docker-php-ext-enable pdo pdo_sqlite pdo_mysql mbstring bcmath zip opcache

RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.max_accelerated_files=10000'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.fast_shutdown=1'; \
} > /usr/local/etc/php/conf.d/opcache.ini

RUN echo "clear_env = no" >> /usr/local/etc/php-fpm.d/www.conf

# Hardening recommended by the CVE-2026-109618 / CVE-2026-109619 advisory.
RUN { \
    echo 'expose_php=Off'; \
    echo 'display_errors=Off'; \
    echo 'session.upload_progress.enabled=Off'; \
} > /usr/local/etc/php/conf.d/security.ini

# Fail the build if the runtime PHP is older than the patched release.
RUN php -r 'exit(version_compare(PHP_VERSION, "8.3.37", "<") ? 1 : 0);'

# Fail the build if nginx is older than 1.30.7 (NGINX2root, CVE-2026-123633,
# CVE-2026-123007 and others). Alpine 3.24 ships nginx 1.30.7-r0 or later.
RUN apk version -t "$(apk info -v | sed -n 's/^nginx-\([0-9].*\)/\1/p')" 1.30.7-r0 | grep -qv '<'

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
